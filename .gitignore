# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Streamlit secrets
.streamlit/secrets.toml

# Keep Streamlit config
!.streamlit/config.toml

# Raw / processed data should not be uploaded
data/raw/
data/processed/
Data/raw/
Data/processed/

# Allow only the demo DuckDB database for Streamlit Cloud
data/database/*
!data/database/insurance_market.duckdb
data/database/backups/
data/database/*candidate*.duckdb
data/database/*candidate*.duckdb.wal
data/database/*candidate*.duckdb.tmp

Data/database/*
!Data/database/insurance_market.duckdb
Data/database/backups/
Data/database/*candidate*.duckdb
Data/database/*candidate*.duckdb.wal
Data/database/*candidate*.duckdb.tmp

# Ignore DuckDB files by default
*.duckdb
*.duckdb.wal
*.wal
*.duckdb.tmp

# But allow the specific demo database
!data/database/insurance_market.duckdb
!Data/database/insurance_market.duckdb

# Generated outputs
outputs/
Outputs/

# Generated pipeline metadata
data/metadata/*.csv
data/metadata/*.json
data/metadata/*.md
data/metadata/**
!data/metadata/README.md
Data/metadata/*.csv
Data/metadata/*.json
Data/metadata/*.md
Data/metadata/**
!Data/metadata/README.md

# Environment variables
.env

# Local backups / temporary files
*_backup_*
*.bak
*.bak_*
*.tmp
*.log

# OS files
.DS_Store
Thumbs.db
