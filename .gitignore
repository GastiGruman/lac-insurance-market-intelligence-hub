# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Streamlit secrets
.streamlit/secrets.toml

# Keep Streamlit config
!.streamlit/config.toml

# Raw / processed data should not be uploaded
data/raw/
data/processed/
Data/raw/
Data/processed/

# Allow only the demo DuckDB database for Streamlit Cloud
data/database/*
!data/database/insurance_market.duckdb

Data/database/*
!Data/database/insurance_market.duckdb

# Ignore DuckDB files by default
*.duckdb
*.duckdb.wal
*.wal
*.duckdb.tmp

# But allow the specific demo database
!data/database/insurance_market.duckdb
!Data/database/insurance_market.duckdb

# Generated outputs
outputs/
Outputs/

# Environment variables
.env

# Local backups / temporary files
*_backup_*
*.bak
*.bak_*
*.tmp
*.log

# OS files
.DS_Store
Thumbs.db
